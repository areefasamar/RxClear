# Copy this file to .env.local and fill in your values.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Model used: gemini-2.0-flash (free tier, supports image input natively)
# NEVER prefix with NEXT_PUBLIC_ — server-side only.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to "true" during local UI development to skip real API calls entirely.
# Flip to "false" when you want to test against the real Gemini endpoint.
MOCK_AI=false

# ── Firebase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
